# ==================================================
# DEBUG-WebGPU-Analyzer 環境変数設定サンプル
# ==================================================
#
# このファイルをコピーして .env ファイルを作成してください
#
#   cp .env.example .env
#
# その後、各ファイルパスを実際のファイルに合わせて編集してください
#

# --------------------------------------------------
# Octree設定
# --------------------------------------------------
# LEAF_CAPACITY: 1ノードあたりの最大点数（小さいほど細かい分割）
#   - 推奨値: 8-32
#   - 小規模データ（~100万点）: 32
#   - 中規模データ（100万~1000万点）: 16
#   - 大規模データ（1000万点~）: 8
LEAF_CAPACITY=16

# BUFFER_CAPACITY: バッファ容量
BUFFER_CAPACITY=16


# --------------------------------------------------
# 永続キャッシュ設定
# --------------------------------------------------
# P_CACHE: キャッシュファイル名（任意の名前）
#   - Origin Private File Systemに "${P_CACHE}.json" として保存される
P_CACHE=cache-holder

# P_CACHE_CAPACITY: 永続キャッシュの最大ノード数
#   - 推奨値: 100-500
P_CACHE_CAPACITY=150


# --------------------------------------------------
# ファイルパス設定
# --------------------------------------------------

# COPC (.copc.laz) - Cloud Optimized Point Cloud
# ローカルファイル または HTTPSのURL
#
# 推奨: リモートURL（HTTP Range Request対応サーバー）
COPC_FILE=https://media.githubusercontent.com/media/sceneserver/copc/main/naarden-vesting.copc.laz
# ローカルファイルの例:
# COPC_FILE=dataset/copc/sample.copc.laz

# その他のCOPCファイル例（コメントアウト）:
# COPC_FILE=https://media.githubusercontent.com/media/pravinpoudel/LAZ-COPC-Converter/main/morro_20m-reprojected.copc.laz
# COPC_FILE=https://media.githubusercontent.com/media/pravinpoudel/LAZ-COPC-Converter/main/u_campus_30m.copc.laz
# COPC_FILE=https://hobu-lidar.s3.amazonaws.com/sofi.copc.laz


# LAS (.las) - 非圧縮点群ファイル
# ローカルファイルパス（プロジェクトルート基準の相対パス）
LAS_FILES=dataset/las/sample.las
# 例: LAS_FILES=dataset/las/09KD9817.las


# LAZ (.laz) - 圧縮点群ファイル
# 注意: v1.0-1.3のみ対応。v1.4は laz-converter で変換が必要
LAZ_FILES=dataset/laz/sample.laz
# 例: LAZ_FILES=dataset/laz/v13_200406_100502_Sample.laz


# XYZ (.xyz) - テキスト形式点群ファイル
# フォーマット: X Y Z または X Y Z R G B
XYZ_FILES=dataset/xyz/sample.xyz
# 例: XYZ_FILES=dataset/xyz/A1_20220512.xyz


# TIF/TIFF (.tif, .tiff) - ラスターデータ
# RGB画像、標高データ、複合データに対応
TIF_FIlES=dataset/tif/sample.tif
# 例: TIF_FIlES=dataset/tif/09KD9816.tif


# --------------------------------------------------
# 複数ファイル対応（将来実装予定）
# --------------------------------------------------
# 現在は未実装ですが、将来的に複数ファイルの同時読み込みに対応予定
# POINT_CLOUD_FILES=["dataset/las/file1.las", "dataset/xyz/file2.xyz"]

# 単一ファイルの配列形式（現在使用可能）
POINT_CLOUD_FILES=["dataset/las/sample.las"]

# 複数ファイルの例（将来対応予定）:
# POINT_CLOUD_FILES=[
#   "https://media.githubusercontent.com/media/sceneserver/copc/main/naarden-vesting.copc.laz",
#   "dataset/las/09KD9817.las",
#   "dataset/laz/200406_100502_Sample.laz",
#   "dataset/tif/09KD9816.tif",
#   "dataset/xyz/A1_20220512.xyz"
# ]


# ==================================================
# 設定後の手順
# ==================================================
#
# 1. .env ファイルを保存
# 2. src/index.ts で使用するローダーを選択
#    例: const { filename, vectorType } = _laz_file_loader();
# 3. ビルドを実行
#    npm run build または npm run dev
# 4. ブラウザで確認
#    http://localhost:8080
#
# 詳細は docs/file-loading-configuration.md を参照してください
#
