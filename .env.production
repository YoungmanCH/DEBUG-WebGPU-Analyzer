# --------------------------------------------------
# 本番環境用設定
# --------------------------------------------------

# --------------------------------------------------
# Octree設定
# --------------------------------------------------
LEAF_CAPACITY=16
BUFFER_CAPACITY=16

# --------------------------------------------------
# 永続キャッシュ設定
# --------------------------------------------------
P_CACHE=cache-holder
P_CACHE_CAPACITY=150
LRU_CACHE_CAPACITY=500
MAX_BUFFER_NODES=5000

# --------------------------------------------------
# ファイルパス設定（本番環境）
# --------------------------------------------------

# COPC (.copc.laz)
#
# オプション1: GitHub Pagesで配信（小規模データ向け）
# リポジトリ名がパスに含まれる場合: /DEBUG-WebGPU-Analyzer/dataset/...
# COPC_FILE=/DEBUG-WebGPU-Analyzer/dataset/output/tokyo_merged_8bit.copc.laz
#
# オプション2: 外部CDN/サーバーで配信（推奨、大規模データ向け）
# GitHub Media URLやS3などのCORS対応サーバー
COPC_FILE=https://media.githubusercontent.com/media/sceneserver/copc/main/naarden-vesting.copc.laz
#
# オプション3: 独自S3バケットやCDN（本番運用向け）
# COPC_FILE=https://your-cdn.example.com/path/to/file.copc.laz

# LAS (.las)
# GitHub Pagesで配信する場合
# LAS_FILES=/DEBUG-WebGPU-Analyzer/dataset/output/tokyo_small-merged_v12.las

# LAZ (.laz)
# LAZ_FILES=/DEBUG-WebGPU-Analyzer/dataset/output/tokyo_small-merged_v12.laz

# XYZ (.xyz)
# XYZ_FILES=/DEBUG-WebGPU-Analyzer/dataset/output/tokyo_small-merged_v12.xyz

# TIF/TIFF (.tif, .tiff)
# TIF_FIlES=/DEBUG-WebGPU-Analyzer/dataset/output/tokyo_small.tif

# 複数ファイル対応（将来実装予定）
POINT_CLOUD_FILES=["https://media.githubusercontent.com/media/sceneserver/copc/main/naarden-vesting.copc.laz"]

# --------------------------------------------------
# 注意事項
# --------------------------------------------------
#
# 1. GitHub Pagesで大容量ファイル（100MB+）を配信すると遅くなる可能性があります
# 2. CORS対応が必須: 外部サーバーからファイルを読み込む場合、サーバーがCORSヘッダーを返す必要があります
# 3. Range Request対応が必須: COPCファイルは部分読み込みが必要なため、サーバーがRange Requestに対応している必要があります
# 4. GitHub LFSを使用する場合: Git LFSでdatasetファイルを管理し、GitHub Mediaからアクセス可能
#    形式: https://media.githubusercontent.com/media/{username}/{repo}/{branch}/{path}
#
